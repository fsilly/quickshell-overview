# --- Symlink ROADMAP.md to ~/Documents/xxx ---
TARGET_DIR="$HOME/Here on earth/8 - project symlinks/qs-overview"
TARGET_LINK="$TARGET_DIR/ROADMAP.md"
SOURCE_FILE="$PWD/ROADMAP.md"

# Ensure target directory exists
mkdir -p "$TARGET_DIR"

# Create or update symlink (idempotent)
if [ -f "$SOURCE_FILE" ]; then
  ln -sf "$SOURCE_FILE" "$TARGET_LINK"
fi
